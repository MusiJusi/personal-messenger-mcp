# demo: fictional chats, no Telegram connection or actual sends.
# telegram: your personal account, after running the login command.
MESSENGER_MODE=demo

# Obtain locally from https://my.telegram.org/apps. Never paste these in a chat.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Relative paths resolve against this project, independent of LM Studio's cwd.
TELEGRAM_SESSION=.state/account
MESSENGER_TIMEZONE=Europe/Moscow

# Optional comma-separated numeric chat IDs. Empty = all accessible dialogs.
TELEGRAM_ALLOWED_CHAT_IDS=

# Optional: expose only reading tools for a particular setup.
TELEGRAM_READ_ONLY=false
